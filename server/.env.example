# Copy to .env and fill in. Never commit real secrets.
DATABASE_URL=postgres://nova:CHANGE_ME@localhost:5432/nova
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
PORT=4000
# Public origin of the web app (used in certificate QR links + CORS)
PUBLIC_URL=http://localhost:5173
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50
# Set to "production" in production (secure cookies, no demo seeding)
NODE_ENV=development
