{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shifra-digital-awareness",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // One always-addressable instance runs the Node API + the built web app (Dockerfile at repo root)
  "containers": [
    { "class_name": "ShifraApp", "image": "./Dockerfile", "instance_type": "basic", "max_instances": 2 }
  ],
  "durable_objects": { "bindings": [{ "name": "APP", "class_name": "ShifraApp" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShifraApp"] }],

  // Scheduled jobs: stage-opening / closing notifications, expiring attempts, timed-out tests
  "triggers": { "crons": ["*/30 * * * *"] },

  "vars": {
    "S3_BUCKET": "shifra-files",
    "MAX_UPLOAD_MB": "50"
  },
  // Keep variables set in the dashboard (PUBLIC_URL, S3_ENDPOINT) across Git deploys
  "keep_vars": true
  // Set in the dashboard (Settings → Variables and Secrets) or with `npx wrangler secret put NAME`:
  //   PUBLIC_URL, S3_ENDPOINT, DATABASE_URL, JWT_SECRET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, JOBS_TOKEN
}
