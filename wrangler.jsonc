{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shifra-digital-awareness",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // One always-addressable instance runs the Node API + the built web app (Dockerfile at repo root)
  "containers": [
    { "class_name": "ShifraApp", "image": "./Dockerfile", "instance_type": "basic", "max_instances": 2 }
  ],
  "durable_objects": { "bindings": [{ "name": "APP", "class_name": "ShifraApp" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShifraApp"] }],

  // Scheduled jobs: stage-opening / closing notifications, expiring attempts, timed-out tests
  "triggers": { "crons": ["*/30 * * * *"] },

  "vars": {
    "PUBLIC_URL": "https://shifra-digital-awareness.<your-subdomain>.workers.dev",
    "S3_ENDPOINT": "https://<ACCOUNT_ID>.r2.cloudflarestorage.com",
    "S3_BUCKET": "shifra-files",
    "MAX_UPLOAD_MB": "50"
  }
  // Secrets (set with: npx wrangler secret put NAME):
  //   DATABASE_URL, JWT_SECRET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, JOBS_TOKEN
}
